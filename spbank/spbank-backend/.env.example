# Copie para .env e escolha senhas locais antes de executar.
MYSQL_HOST_PORT=23307
MYSQL_DATABASE=spbank
MYSQL_USER=spbank
MYSQL_PASSWORD=escolha-uma-senha-local
MYSQL_ROOT_PASSWORD=escolha-outra-senha-local
# Mantenha esta chave estavel para ler os cartoes ja emitidos.
CARD_DATA_SECRET=spbank-local-study-card-secret-change-before-deployment
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
