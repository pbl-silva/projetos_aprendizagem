<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Valores vindos do Spring, com defaults seguros para execucao normal. -->
    <springProperty name="LOG_FILE" source="logging.file.name" defaultValue="logs/ecommerce.log"/>
    <springProperty name="APP_LOG_LEVEL" source="logging.level.com.ecommerce" defaultValue="INFO"/>
    <springProperty name="WEB_LOG_LEVEL" source="logging.level.org.springframework.web" defaultValue="INFO"/>
    <springProperty name="SECURITY_LOG_LEVEL" source="logging.level.org.springframework.security" defaultValue="INFO"/>
    <springProperty name="SQL_LOG_LEVEL" source="logging.level.org.hibernate.SQL" defaultValue="WARN"/>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- File Appender com Rolling Policy -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/ecommerce-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Loggers -->
    <logger name="com.ecommerce" level="${APP_LOG_LEVEL}"/>
    <logger name="org.springframework.web" level="${WEB_LOG_LEVEL}"/>
    <logger name="org.springframework.security" level="${SECURITY_LOG_LEVEL}"/>
    <logger name="org.hibernate.SQL" level="${SQL_LOG_LEVEL}"/>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
